{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "docker:enableMajor",
    ":semanticCommits",
    ":timezone(America/New_York)"
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "flux": {
    "managerFilePatterns": [
      "/(^|/)cluster/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)cluster/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)cluster/.+\\.ya?ml$/"
    ]
  },
  "prHourlyLimit": 10,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "groupName": "immich containers",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app{/,}**"
      ]
    },
    {
      "groupName": "renovate",
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "minor": {
        "automerge": true
      },
      "patch": {
        "automerge": true
      },
      "matchPackageNames": [
        "/renovate/"
      ]
    },
    {
      "groupName": "wishly",
      "matchDatasources": [
        "docker"
      ],
      "enabled": false,
      "matchPackageNames": [
        "/wishly/"
      ]
    },
    {
      "groupName": "node-feature-discovery",
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "matchPackageNames": [
        "/node-feature-discovery/"
      ]
    },
    {
      "groupName": "authentik",
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "matchPackageNames": [
        "/authentik/"
      ]
    },
    {
      "groupName": "metallb",
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "matchPackageNames": [
        "/metallb/"
      ]
    },
    {
      "groupName": "planka",
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "matchPackageNames": [
        "/planka/"
      ]
    },
    {
      "groupName": "1password connect",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/1password/connect-api",
        "docker.io/1password/connect-sync"
      ]
    },
    {
      "groupName": "intel device plugins",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "/intel-device-plugins/"
      ]
    },
    {
      "groupName": "flux controllers",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/fluxcd{/,}**"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "jellyfin/jellyfin"
      ],
      "versioning": "loose",
      "allowedVersions": "/^\\d{1,2}\\.\\d+(\\.\\d+)?$/"
    }
  ],
  "platformAutomerge": true
}
